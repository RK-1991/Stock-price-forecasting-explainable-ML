# 01_data_collection.ipynb

# Step 1: Import libraries
import yfinance as yf  # To download stock data
import pandas as pd    # To handle data in tables

# Step 2: Define which stock to download
stock_symbol = 'AAPL'  # Apple Inc. You can change to GOOGL or MSFT
start_date = '2022-01-01'
end_date = '2025-12-16'

# Step 3: Download stock data
data = yf.download(stock_symbol, start=start_date, end=end_date)

# Step 4: Display first 5 rows
print(data.head())

# Step 5: Save data as CSV
data.to_csv('../data/raw_stock_data.csv')
