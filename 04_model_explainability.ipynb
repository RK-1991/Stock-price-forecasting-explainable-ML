# 04_model_explainability.ipynb

# Step 1: Import libraries
import pandas as pd
import joblib
import shap
import matplotlib.pyplot as plt

# Step 2: Load engineered features and trained model
data = pd.read_csv('../data/stock_features.csv', index_col='Date', parse_dates=True)
model = joblib.load('../results/linear_model.pkl')

# Step 3: Define features and target
features = ['MA_5', 'MA_10', 'Return', 'Volatility_5', 'Volatility_10']
X = data[features]

# Step 4: Initialize SHAP explainer
explainer = shap.Explainer(model, X)
shap_values = explainer(X)

# Step 5: Summary plot (global feature importance)
shap.summary_plot(shap_values, X)

# Step 6: Force plot for a single prediction (local explanation)
# Choose the last row in dataset as example
shap.initjs()
shap.force_plot(explainer.expected_value, shap_values.values[-1,:], X.iloc[-1,:])

# Step 7: Save summary plot
plt.savefig('../results/shap_summary_plot.png')
