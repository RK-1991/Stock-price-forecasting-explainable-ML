# 02_feature_engineering.ipynb

# Step 1: Import libraries
import pandas as pd

# Step 2: Load raw stock data
data = pd.read_csv('../data/raw_stock_data.csv', index_col='Date', parse_dates=True)

# Step 3: Create new features

# 3a. Moving Averages (Trend)
data['MA_5'] = data['Close'].rolling(window=5).mean()   # 5-day average
data['MA_10'] = data['Close'].rolling(window=10).mean() # 10-day average

# 3b. Daily Returns (Momentum)
data['Return'] = data['Close'].pct_change()

# 3c. Volatility (Risk)
data['Volatility_5'] = data['Return'].rolling(window=5).std()
data['Volatility_10'] = data['Return'].rolling(window=10).std()

# Step 4: Drop rows with missing values
data = data.dropna()

# Step 5: Save engineered features
data.to_csv('../data/stock_features.csv')

# Step 6: Display first 5 rows
print(data.head())
